{
  "mailer_subjects_confirmation": "Confirme seu e-mail na ZXMAX",
  "mailer_templates_confirmation_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Confirme seu e-mail</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Seu cadastro foi criado. Confirme este endereço para ativar sua conta e continuar na ZXMAX.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#168cff;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:13px 18px;border-radius:11px\">Confirmar e-mail</a></p><p style=\"margin:16px 0 0;font-size:11px;line-height:1.5;color:#737986;word-break:break-all\">{{ .ConfirmationURL }}</p><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>",
  "mailer_subjects_recovery": "Redefina sua senha da ZXMAX",
  "mailer_templates_recovery_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Redefinição de senha</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Recebemos uma solicitação para alterar a senha da sua conta. Use o botão abaixo para continuar com segurança.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#168cff;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:13px 18px;border-radius:11px\">Redefinir senha</a></p><p style=\"margin:16px 0 0;font-size:11px;line-height:1.5;color:#737986;word-break:break-all\">{{ .ConfirmationURL }}</p><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>",
  "mailer_subjects_magic_link": "Seu acesso seguro à ZXMAX",
  "mailer_templates_magic_link_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Acesso à sua conta</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Use o botão abaixo para entrar. O link é temporário e deve ser usado somente por você.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#168cff;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:13px 18px;border-radius:11px\">Entrar na ZXMAX</a></p><p style=\"margin:16px 0 0;font-size:11px;line-height:1.5;color:#737986;word-break:break-all\">{{ .ConfirmationURL }}</p><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>",
  "mailer_subjects_invite": "Você foi convidado para a ZXMAX",
  "mailer_templates_invite_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Convite para a ZXMAX</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Você recebeu um convite para criar e acessar uma conta na plataforma.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#168cff;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:13px 18px;border-radius:11px\">Aceitar convite</a></p><p style=\"margin:16px 0 0;font-size:11px;line-height:1.5;color:#737986;word-break:break-all\">{{ .ConfirmationURL }}</p><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>",
  "mailer_subjects_email_change": "Confirme seu novo e-mail da ZXMAX",
  "mailer_templates_email_change_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Confirme o novo endereço</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Foi solicitada a alteração do e-mail da sua conta. Confirme o novo endereço abaixo.</p><p style=\"margin:18px 0 0;color:#fff;font-size:13px\"><strong>Novo e-mail:</strong> {{ .NewEmail }}</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#168cff;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:13px 18px;border-radius:11px\">Confirmar novo e-mail</a></p><p style=\"margin:16px 0 0;font-size:11px;line-height:1.5;color:#737986;word-break:break-all\">{{ .ConfirmationURL }}</p><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>",
  "mailer_subjects_reauthentication": "{{ .Token }} é seu código ZXMAX",
  "mailer_templates_reauthentication_content": "<div style=\"margin:0;padding:32px 12px;background:#07080b;font-family:Arial,Helvetica,sans-serif;color:#f5f7fb\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\"><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;max-width:560px;background:#111217;border:1px solid #24262d;border-radius:20px;overflow:hidden\"><tr><td style=\"padding:28px 28px 18px\"><div style=\"font-size:22px;font-weight:900;letter-spacing:-.8px;color:#fff\">ZXMAX</div><div style=\"margin-top:7px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#5faeff\">Segurança da conta</div></td></tr><tr><td style=\"padding:0 28px 28px\"><h1 style=\"margin:0 0 10px;font-size:24px;line-height:1.25;color:#fff\">Código de verificação</h1><p style=\"margin:0;color:#b5bac5;font-size:14px;line-height:1.7\">Use este código para confirmar sua identidade. Ele expira em pouco tempo.</p><div style=\"margin:22px 0;padding:18px;border:1px solid #2b6da8;background:#0b2035;border-radius:14px;text-align:center;font-size:30px;font-weight:900;letter-spacing:7px;color:#8ecbff\">{{ .Token }}</div><div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #24262d;font-size:11px;line-height:1.6;color:#7f8591\">Se você não iniciou esta ação, ignore este e-mail. Nunca compartilhe códigos ou senhas.</div></td></tr></table></td></tr></table></div>"
}